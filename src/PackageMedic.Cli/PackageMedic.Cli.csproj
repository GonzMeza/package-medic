<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>package-medic</AssemblyName>
    <RootNamespace>PackageMedic.Cli</RootNamespace>
    <PackageId>PackageMedic.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>package-medic</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>packagemedic-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/GonzMeza/package-medic</PackageProjectUrl>
    <PackageReleaseNotes>PackageMedic 0.4 adds opt-in NuGet vulnerability auditing with PM007, direct and transitive package inventory, safe Git-reference comparisons, and matching GitHub Action controls while remaining fully read-only. Full notes: https://github.com/GonzMeza/package-medic/blob/v$(PackageMedicVersion)/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>dotnet;nuget;dependencies;msbuild;central-package-management;dotnet-tool;sarif;github-actions;code-scanning;ci;baseline;dependency-policy;vulnerability-audit;dependency-diff</PackageTags>
    <Description>A read-only dependency doctor for SDK-style .NET projects.</Description>
    <Title>PackageMedic</Title>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PackageMedic.IntegrationTests" />
    <ProjectReference Include="..\PackageMedic.Core\PackageMedic.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\assets\brand\packagemedic-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
