<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>package-medic</AssemblyName>
    <RootNamespace>PackageMedic.Cli</RootNamespace>
    <Version>0.1.0-preview.1</Version>
    <PackageId>PackageMedic.Tool</PackageId>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>package-medic</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet;nuget;dependencies;msbuild;central-package-management;dotnet-tool</PackageTags>
    <Description>A read-only dependency doctor for SDK-style .NET projects.</Description>
    <Title>PackageMedic</Title>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PackageMedic.Core\PackageMedic.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
