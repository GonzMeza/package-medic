{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GonzMeza/package-medic/main/schemas/packagemedic-simulation.schema.json",
  "title": "PackageMedic dependency simulation report",
  "description": "Schema 2 for Dependency Time Machine reports, including optional structured restore/build/test verification evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "toolVersion",
    "repository",
    "request",
    "mutation",
    "verification",
    "comparison",
    "isComplete",
    "verdict",
    "rejectionReasons",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "dependencySimulation" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headCommit", "analysisTarget", "workingTreeRequiredClean"],
      "properties": {
        "headCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "analysisTarget": { "$ref": "#/$defs/portablePath" },
        "workingTreeRequiredClean": { "const": true }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "candidateVersion"],
      "properties": {
        "packageId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId", "file", "line", "kind", "beforeVersion", "candidateVersion",
        "affectedProjects", "noChange", "sourceSha256Before", "sourceSha256After"
      ],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "file": { "$ref": "#/$defs/portablePath" },
        "line": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": ["centralPackageVersion", "packageReferenceVersion", "packageReferenceOverride"]
        },
        "beforeVersion": { "type": "string", "minLength": 1 },
        "candidateVersion": { "type": "string", "minLength": 1 },
        "affectedProjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        },
        "noChange": { "type": "boolean" },
        "sourceSha256Before": { "$ref": "#/$defs/sha256" },
        "sourceSha256After": { "$ref": "#/$defs/sha256" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restore", "build", "tests", "runtimeCompatibility", "evidenceLevel",
        "auditedVulnerabilities", "auditedDeprecations", "lockedMode"
      ],
      "properties": {
        "restore": { "enum": ["passed", "failed", "incomplete", "notRun"] },
        "requestedLevel": { "enum": ["restore", "build", "test"] },
        "restoreFailureKind": {
          "enum": [
            "packageNotFound", "versionNotFound", "dependencyConflict", "lockedModeConflict",
            "sourceUnavailable", "authenticationFailed", "timedOut", "outputLimitExceeded", "unknown"
          ]
        },
        "build": { "enum": ["passed", "failed", "incomplete", "notRun"] },
        "tests": { "enum": ["passed", "failed", "incomplete", "notRun"] },
        "runtimeCompatibility": { "const": "notVerified" },
        "evidenceLevel": { "enum": ["restoreOnly", "buildVerified", "testVerified"] },
        "auditedVulnerabilities": { "type": "boolean" },
        "auditedDeprecations": { "type": "boolean" },
        "lockedMode": { "enum": ["notEnabled", "enforced", "mixed"] },
        "executed": { "$ref": "#/$defs/verificationComparison" }
      },
      "allOf": [
        {
          "if": { "properties": { "restore": { "enum": ["failed", "incomplete"] } } },
          "then": { "required": ["restoreFailureKind"] },
          "else": { "not": { "required": ["restoreFailureKind"] } }
        },
        {
          "if": { "not": { "required": ["executed"] } },
          "then": {
            "properties": {
              "build": { "const": "notRun" },
              "tests": { "const": "notRun" },
              "evidenceLevel": { "const": "restoreOnly" }
            }
          }
        },
        {
          "if": { "required": ["executed"] },
          "then": {
            "required": ["requestedLevel"],
            "allOf": [
              {
                "oneOf": [
                  {
                    "properties": {
                      "build": { "const": "notRun" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "build": {
                                "properties": {
                                  "stage": { "properties": { "status": { "const": "notRequested" } } }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "build": { "const": "passed" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "build": {
                                "properties": { "stage": { "properties": { "status": { "const": "passed" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "build": { "const": "failed" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "build": {
                                "properties": { "stage": { "properties": { "status": { "const": "failed" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "build": { "const": "incomplete" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "build": {
                                "properties": { "stage": { "properties": { "status": { "const": "incomplete" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "properties": {
                      "tests": { "const": "notRun" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "tests": {
                                "properties": {
                                  "stage": { "properties": { "status": { "const": "notRequested" } } }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "tests": { "const": "passed" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "tests": {
                                "properties": { "stage": { "properties": { "status": { "const": "passed" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "tests": { "const": "failed" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "tests": {
                                "properties": { "stage": { "properties": { "status": { "const": "failed" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "tests": { "const": "incomplete" },
                      "executed": {
                        "properties": {
                          "candidate": {
                            "properties": {
                              "tests": {
                                "properties": { "stage": { "properties": { "status": { "const": "incomplete" } } } }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "properties": {
                      "evidenceLevel": { "const": "restoreOnly" },
                      "executed": {
                        "properties": {
                          "decision": {
                            "properties": { "commonEvidenceLevel": { "enum": ["none", "restoreOnly"] } }
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "evidenceLevel": { "const": "buildVerified" },
                      "executed": {
                        "properties": {
                          "decision": { "properties": { "commonEvidenceLevel": { "const": "buildVerified" } } }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "evidenceLevel": { "const": "testVerified" },
                      "executed": {
                        "properties": {
                          "decision": { "properties": { "commonEvidenceLevel": { "const": "testVerified" } } }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticSummary", "diagnosticChanges", "packageSummary", "packageChanges",
        "riskSummary", "projectSettingsChanges", "isComplete"
      ],
      "properties": {
        "diagnosticSummary": { "$ref": "#/$defs/diagnosticSummary" },
        "diagnosticChanges": { "type": "array", "items": { "$ref": "#/$defs/diagnosticChange" } },
        "packageSummary": { "$ref": "#/$defs/packageSummary" },
        "packageChanges": { "type": "array", "items": { "$ref": "#/$defs/packageChange" } },
        "riskSummary": { "$ref": "#/$defs/riskSummary" },
        "projectSettingsChanges": { "type": "array", "items": { "$ref": "#/$defs/projectSettingsChange" } },
        "impact": { "$ref": "#/$defs/impact" },
        "isComplete": { "type": "boolean" },
        "unavailableReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "isComplete": { "const": false } } },
          "then": { "required": ["unavailableReason"] },
          "else": { "not": { "required": ["unavailableReason"] } }
        }
      ]
    },
    "isComplete": { "type": "boolean" },
    "verdict": { "enum": ["pass", "reject", "noChange", "incomplete"] },
    "rejectionReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "enum": ["pass", "noChange"] } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "isComplete": { "const": true },
          "rejectionReasons": { "maxItems": 0 },
          "errors": { "maxItems": 0 },
          "verification": {
            "properties": { "restore": { "const": "passed" } },
            "required": ["restore"]
          },
          "comparison": {
            "properties": { "isComplete": { "const": true } },
            "required": ["isComplete"]
          }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "reject" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "isComplete": { "const": true },
          "rejectionReasons": { "minItems": 1 },
          "errors": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "incomplete" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "isComplete": { "const": false },
          "rejectionReasons": { "maxItems": 0 },
          "errors": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "executed": {
                "properties": {
                  "decision": { "properties": { "verdict": { "const": "reject" } } }
                },
                "required": ["decision"]
              }
            },
            "required": ["executed"]
          }
        },
        "required": ["verification"]
      },
      "then": { "properties": { "verdict": { "const": "reject" } } }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "executed": {
                "properties": {
                  "decision": { "properties": { "verdict": { "const": "incomplete" } } }
                },
                "required": ["decision"]
              }
            },
            "required": ["executed"]
          }
        },
        "required": ["verification"]
      },
      "then": { "properties": { "verdict": { "const": "incomplete" } } }
    }
  ],
  "$defs": {
    "verificationComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "baseline", "candidate", "decision"],
      "properties": {
        "level": { "enum": ["restore", "build", "test"] },
        "baseline": { "$ref": "#/$defs/verificationSnapshot" },
        "candidate": { "$ref": "#/$defs/verificationSnapshot" },
        "decision": { "$ref": "#/$defs/verificationDecision" }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "restore" } }, "required": ["level"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/restoreOnlySnapshot" },
              "candidate": { "$ref": "#/$defs/restoreOnlySnapshot" }
            }
          }
        },
        {
          "if": { "properties": { "level": { "const": "build" } }, "required": ["level"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/noTestSnapshot" },
              "candidate": { "$ref": "#/$defs/noTestSnapshot" }
            }
          }
        }
      ]
    },
    "verificationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restore", "build", "tests"],
      "properties": {
        "restore": { "$ref": "#/$defs/restoreStageEvidence" },
        "build": { "$ref": "#/$defs/verificationBuildReport" },
        "tests": { "$ref": "#/$defs/verificationTestReport" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "restore": {
                "properties": { "status": { "enum": ["failed", "incomplete"] } },
                "required": ["status"]
              }
            },
            "required": ["restore"]
          },
          "then": {
            "properties": {
              "build": { "$ref": "#/$defs/notRequestedBuildReport" },
              "tests": { "$ref": "#/$defs/notRequestedTestReport" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "stage": {
                    "properties": { "status": { "enum": ["failed", "incomplete"] } },
                    "required": ["status"]
                  }
                },
                "required": ["stage"]
              }
            },
            "required": ["build"]
          },
          "then": { "properties": { "tests": { "$ref": "#/$defs/notRequestedTestReport" } } }
        }
      ]
    },
    "restoreOnlySnapshot": {
      "allOf": [
        { "$ref": "#/$defs/verificationSnapshot" },
        {
          "properties": {
            "build": { "$ref": "#/$defs/notRequestedBuildReport" },
            "tests": { "$ref": "#/$defs/notRequestedTestReport" }
          }
        }
      ]
    },
    "noTestSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/verificationSnapshot" },
        { "properties": { "tests": { "$ref": "#/$defs/notRequestedTestReport" } } }
      ]
    },
    "restoreStageEvidence": {
      "allOf": [
        { "$ref": "#/$defs/stageEvidence" },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "failureKind": {
                "enum": ["packageNotFound", "versionNotFound", "dependencyConflict", "lockedModeConflict"]
              }
            }
          }
        }
      ]
    },
    "buildStageEvidence": {
      "allOf": [
        { "$ref": "#/$defs/stageEvidence" },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "failureKind": { "const": "buildFailed" } } }
        }
      ]
    },
    "testStageEvidence": {
      "allOf": [
        { "$ref": "#/$defs/stageEvidence" },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "failureKind": { "const": "testsFailed" } } }
        }
      ]
    },
    "stageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["notRequested", "passed", "failed", "incomplete"] },
        "failureKind": { "$ref": "#/$defs/verificationFailureKind" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["failed", "incomplete"] } }, "required": ["status"] },
          "then": { "required": ["failureKind"] },
          "else": { "not": { "required": ["failureKind"] } }
        },
        {
          "if": { "properties": { "status": { "const": "incomplete" } }, "required": ["status"] },
          "then": { "properties": { "failureKind": { "$ref": "#/$defs/operationalFailureKind" } } }
        }
      ]
    },
    "verificationBuildReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "plannedTargets", "completedTargets"],
      "properties": {
        "stage": { "$ref": "#/$defs/buildStageEvidence" },
        "plannedTargets": { "type": "integer", "minimum": 0 },
        "completedTargets": { "type": "integer", "minimum": 0 },
        "blockingTarget": { "$ref": "#/$defs/portablePath" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "enum": ["notRequested", "passed"] } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": {
            "not": { "anyOf": [{ "required": ["blockingTarget"] }, { "required": ["failure"] }] }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "const": "passed" } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "plannedTargets": { "type": "integer", "minimum": 1 },
              "completedTargets": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "enum": ["failed", "incomplete"] } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": { "required": ["failure"] }
        }
      ]
    },
    "notRequestedBuildReport": {
      "allOf": [
        { "$ref": "#/$defs/verificationBuildReport" },
        {
          "properties": {
            "stage": {
              "properties": { "status": { "const": "notRequested" } },
              "required": ["status"]
            },
            "plannedTargets": { "const": 0 },
            "completedTargets": { "const": 0 }
          }
        }
      ]
    },
    "verificationTestReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "plannedProjects", "completedProjects", "total", "passed", "failed", "skipped",
        "failedTestIdentities", "hasAdditionalFailedTests"
      ],
      "properties": {
        "stage": { "$ref": "#/$defs/testStageEvidence" },
        "plannedProjects": { "type": "integer", "minimum": 0 },
        "completedProjects": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "failedTestIdentities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "hasAdditionalFailedTests": { "type": "boolean" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "const": "notRequested" } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "plannedProjects": { "const": 0 },
              "completedProjects": { "const": 0 },
              "total": { "const": 0 },
              "passed": { "const": 0 },
              "failed": { "const": 0 },
              "skipped": { "const": 0 },
              "failedTestIdentities": { "maxItems": 0 },
              "hasAdditionalFailedTests": { "const": false }
            },
            "not": { "required": ["failure"] }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "const": "passed" } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "plannedProjects": { "type": "integer", "minimum": 1 },
              "completedProjects": { "type": "integer", "minimum": 1 },
              "total": { "type": "integer", "minimum": 1 },
              "failed": { "const": 0 },
              "failedTestIdentities": { "maxItems": 0 },
              "hasAdditionalFailedTests": { "const": false }
            },
            "not": { "required": ["failure"] }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "properties": { "status": { "enum": ["failed", "incomplete"] } },
                "required": ["status"]
              }
            },
            "required": ["stage"]
          },
          "then": { "required": ["failure"] }
        }
      ]
    },
    "notRequestedTestReport": {
      "allOf": [
        { "$ref": "#/$defs/verificationTestReport" },
        {
          "properties": {
            "stage": {
              "properties": { "status": { "const": "notRequested" } },
              "required": ["status"]
            }
          }
        }
      ]
    },
    "verificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict", "baselineEvidenceLevel", "candidateEvidenceLevel", "commonEvidenceLevel",
        "isComplete", "isAccepted"
      ],
      "properties": {
        "verdict": { "enum": ["pass", "reject", "noChange", "incomplete"] },
        "baselineEvidenceLevel": { "$ref": "#/$defs/verificationEvidenceLevel" },
        "candidateEvidenceLevel": { "$ref": "#/$defs/verificationEvidenceLevel" },
        "commonEvidenceLevel": { "$ref": "#/$defs/verificationEvidenceLevel" },
        "blockingSnapshot": { "enum": ["baseline", "candidate"] },
        "blockingStage": { "enum": ["restore", "build", "test"] },
        "failureKind": { "$ref": "#/$defs/verificationFailureKind" },
        "isComplete": { "type": "boolean" },
        "isAccepted": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "enum": ["pass", "noChange"] } }, "required": ["verdict"] },
          "then": {
            "properties": { "isComplete": { "const": true }, "isAccepted": { "const": true } },
            "not": {
              "anyOf": [
                { "required": ["blockingSnapshot"] },
                { "required": ["blockingStage"] },
                { "required": ["failureKind"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "reject" } }, "required": ["verdict"] },
          "then": {
            "properties": {
              "blockingSnapshot": { "const": "candidate" },
              "isComplete": { "const": true },
              "isAccepted": { "const": false }
            },
            "required": ["blockingSnapshot", "blockingStage", "failureKind"]
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "incomplete" } }, "required": ["verdict"] },
          "then": {
            "properties": { "isComplete": { "const": false }, "isAccepted": { "const": false } },
            "required": ["failureKind"]
          }
        },
        {
          "if": { "required": ["blockingSnapshot"] },
          "then": { "required": ["blockingStage"] }
        },
        {
          "if": { "required": ["blockingStage"] },
          "then": { "required": ["blockingSnapshot"] }
        },
        {
          "if": {
            "properties": { "blockingStage": { "const": "restore" }, "verdict": { "const": "reject" } },
            "required": ["blockingStage", "verdict"]
          },
          "then": {
            "properties": {
              "failureKind": {
                "enum": ["packageNotFound", "versionNotFound", "dependencyConflict", "lockedModeConflict"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "blockingStage": { "const": "build" }, "verdict": { "const": "reject" } },
            "required": ["blockingStage", "verdict"]
          },
          "then": { "properties": { "failureKind": { "const": "buildFailed" } } }
        },
        {
          "if": {
            "properties": { "blockingStage": { "const": "test" }, "verdict": { "const": "reject" } },
            "required": ["blockingStage", "verdict"]
          },
          "then": { "properties": { "failureKind": { "const": "testsFailed" } } }
        }
      ]
    },
    "verificationEvidenceLevel": {
      "enum": ["none", "restoreOnly", "buildVerified", "testVerified"]
    },
    "verificationFailureKind": {
      "enum": [
        "packageNotFound", "versionNotFound", "dependencyConflict", "lockedModeConflict",
        "buildFailed", "testsFailed", "sourceUnavailable", "authenticationFailed", "timedOut",
        "cancelled", "processStartFailed", "outputLimitExceeded", "resultLimitExceeded",
        "testResultsUnavailable", "noTestsDiscovered", "unsupportedRunner", "unsafeEnvironment",
        "snapshotUnavailable", "analysisIncomplete", "comparisonIncomplete", "internalError", "unknown"
      ]
    },
    "operationalFailureKind": {
      "enum": [
        "sourceUnavailable", "authenticationFailed", "timedOut", "cancelled", "processStartFailed",
        "outputLimitExceeded", "resultLimitExceeded", "testResultsUnavailable", "noTestsDiscovered",
        "unsupportedRunner", "unsafeEnvironment", "snapshotUnavailable", "analysisIncomplete",
        "comparisonIncomplete", "internalError", "unknown"
      ]
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|/|\\\\)|(?:^|/)\\.\\.(?:/|$)" }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "diagnosticChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fingerprint"],
      "properties": {
        "kind": { "enum": ["added", "resolved", "severityChanged"] },
        "fingerprint": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/diffDiagnostic" },
        "after": { "$ref": "#/$defs/diffDiagnostic" }
      }
    },
    "diffDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "title", "explanation", "evidence", "suggestedAction"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["information", "warning", "error"] },
        "title": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/portablePath" },
        "file": { "$ref": "#/$defs/portablePath" },
        "line": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string" },
        "suggestedAction": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "originalCode": { "type": "string", "minLength": 1 },
        "packageId": { "type": "string", "minLength": 1 }
      }
    },
    "packageChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "changedAttributes"],
      "properties": {
        "kind": { "enum": ["added", "removed", "versionChanged", "dependencyKindChanged", "modified", "upgraded", "downgraded"] },
        "before": { "$ref": "#/$defs/diffPackage" },
        "after": { "$ref": "#/$defs/diffPackage" },
        "changedAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["resolvedVersion", "requestedVersion", "versionSource", "dependencyKind", "packageSource", "contentHash", "signaturePresent"] }
        }
      }
    },
    "diffPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "framework", "id", "resolvedVersion", "dependencyKind", "versionSource"],
      "properties": {
        "project": { "$ref": "#/$defs/portablePath" },
        "framework": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "resolvedVersion": { "type": "string", "minLength": 1 },
        "dependencyKind": { "enum": ["direct", "transitive"] },
        "requestedVersion": { "type": "string", "minLength": 1 },
        "versionSource": { "type": "string", "minLength": 1 },
        "runtimeIdentifier": { "type": "string", "minLength": 1 },
        "packageSource": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "signaturePresent": { "type": "boolean" }
      }
    },
    "projectSettingsChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project"],
      "properties": {
        "kind": { "enum": ["added", "removed", "modified"] },
        "project": { "$ref": "#/$defs/portablePath" },
        "before": { "$ref": "#/$defs/projectSettings" },
        "after": { "$ref": "#/$defs/projectSettings" }
      }
    },
    "projectSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project", "managePackageVersionsCentrally", "centralPackageTransitivePinningEnabled",
        "packageSourceCount", "packageSourceMappingEnabled", "restorePackagesWithLockFile",
        "restoreLockedMode", "lockFileAvailable"
      ],
      "properties": {
        "project": { "$ref": "#/$defs/portablePath" },
        "managePackageVersionsCentrally": { "type": "boolean" },
        "centralPackageTransitivePinningEnabled": { "type": "boolean" },
        "packageSourceCount": { "type": "integer", "minimum": 0 },
        "packageSourceMappingEnabled": { "type": "boolean" },
        "restorePackagesWithLockFile": { "type": "boolean" },
        "restoreLockedMode": { "type": "boolean" },
        "lockFileAvailable": { "type": "boolean" }
      }
    },
    "diagnosticSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "resolved", "severityChanged"],
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "severityChanged": { "type": "integer", "minimum": 0 }
      }
    },
    "packageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added", "removed", "upgraded", "downgraded", "uncomparableVersionChanges",
        "directToTransitive", "transitiveToDirect", "otherModified"
      ],
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "upgraded": { "type": "integer", "minimum": 0 },
        "downgraded": { "type": "integer", "minimum": 0 },
        "uncomparableVersionChanges": { "type": "integer", "minimum": 0 },
        "directToTransitive": { "type": "integer", "minimum": 0 },
        "transitiveToDirect": { "type": "integer", "minimum": 0 },
        "otherModified": { "type": "integer", "minimum": 0 }
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vulnerabilitiesIntroduced", "vulnerabilitiesResolved", "deprecationsIntroduced",
        "deprecationsResolved", "vulnerabilitiesPersistent", "deprecationsPersistent"
      ],
      "properties": {
        "vulnerabilitiesIntroduced": { "type": "integer", "minimum": 0 },
        "vulnerabilitiesResolved": { "type": "integer", "minimum": 0 },
        "deprecationsIntroduced": { "type": "integer", "minimum": 0 },
        "deprecationsResolved": { "type": "integer", "minimum": 0 },
        "vulnerabilitiesPersistent": { "type": "integer", "minimum": 0 },
        "deprecationsPersistent": { "type": "integer", "minimum": 0 }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "packages", "violations", "policy", "gatePassed"],
      "properties": {
        "summary": { "$ref": "#/$defs/impactSummary" },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/packageImpact" } },
        "violations": { "type": "array", "items": { "$ref": "#/$defs/impactViolation" } },
        "policy": { "$ref": "#/$defs/impactPolicy" },
        "gatePassed": { "type": "boolean" }
      }
    },
    "impactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changedPackages", "addedDirectPackages", "addedTransitivePackages", "removedPackages",
        "upgrades", "downgrades", "directToTransitive", "transitiveToDirect", "sourceChanges",
        "contentChanges", "maximumBlastRadius", "violations"
      ],
      "properties": {
        "changedPackages": { "type": "integer", "minimum": 0 },
        "addedDirectPackages": { "type": "integer", "minimum": 0 },
        "addedTransitivePackages": { "type": "integer", "minimum": 0 },
        "removedPackages": { "type": "integer", "minimum": 0 },
        "upgrades": { "type": "integer", "minimum": 0 },
        "downgrades": { "type": "integer", "minimum": 0 },
        "directToTransitive": { "type": "integer", "minimum": 0 },
        "transitiveToDirect": { "type": "integer", "minimum": 0 },
        "sourceChanges": { "type": "integer", "minimum": 0 },
        "contentChanges": { "type": "integer", "minimum": 0 },
        "maximumBlastRadius": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 }
      }
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "resolvedVersion"],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "resolvedVersion": { "type": "string", "minLength": 1 }
      }
    },
    "packageImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project", "framework", "packageId", "dependencyKind", "dependencyPath"],
      "properties": {
        "kind": { "enum": ["added", "removed", "versionChanged", "dependencyKindChanged", "modified", "upgraded", "downgraded"] },
        "project": { "$ref": "#/$defs/portablePath" },
        "framework": { "type": "string", "minLength": 1 },
        "runtimeIdentifier": { "type": "string", "minLength": 1 },
        "packageId": { "type": "string", "minLength": 1 },
        "beforeVersion": { "type": "string", "minLength": 1 },
        "afterVersion": { "type": "string", "minLength": 1 },
        "dependencyKind": { "enum": ["direct", "transitive"] },
        "rootPackageId": { "type": "string", "minLength": 1 },
        "dependencyPath": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } },
        "sourceBefore": { "type": "string", "minLength": 1 },
        "sourceAfter": { "type": "string", "minLength": 1 },
        "contentHashBefore": { "type": "string", "minLength": 1 },
        "contentHashAfter": { "type": "string", "minLength": 1 },
        "signaturePresent": { "type": "boolean" }
      }
    },
    "impactViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "message", "suggestedAction"],
      "properties": {
        "code": { "type": "string", "pattern": "^PMI[0-9]{3}$" },
        "kind": {
          "enum": [
            "packageDowngrade", "directToTransitive", "addedPackageBudgetExceeded",
            "addedTransitiveBudgetExceeded", "packageSourceChanged", "packageSourceNotAllowed",
            "packageSourceUnknown", "packageContentChanged", "packageSourceMappingRequired",
            "lockedModeRequired"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "suggestedAction": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/portablePath" },
        "framework": { "type": "string", "minLength": 1 },
        "packageId": { "type": "string", "minLength": 1 },
        "rootPackageId": { "type": "string", "minLength": 1 },
        "dependencyPath": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } }
      }
    },
    "impactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failOnDowngrade", "failOnDirectToTransitive", "failOnSourceChange",
        "failOnContentChange", "requirePackageSourceMapping", "requireLockedMode", "allowedSources"
      ],
      "properties": {
        "failOnDowngrade": { "type": "boolean" },
        "failOnDirectToTransitive": { "type": "boolean" },
        "maxAddedPackages": { "type": "integer", "minimum": 0 },
        "maxAddedTransitivePackages": { "type": "integer", "minimum": 0 },
        "failOnSourceChange": { "type": "boolean" },
        "failOnContentChange": { "type": "boolean" },
        "requirePackageSourceMapping": { "type": "boolean" },
        "requireLockedMode": { "type": "boolean" },
        "allowedSources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
