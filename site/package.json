{
  "name": "packagemedic-site",
  "version": "0.6.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "predev": "npm run sync-version",
    "dev": "next dev",
    "prebuild": "npm run sync-version",
    "build": "next build",
    "build:pages": "npm run build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint .",
    "audit:lockfile": "node scripts/verify-lockfile.mjs",
    "audit:security": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
